PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=campusos
DB_PASSWORD=replace-with-local-database-password
DB_NAME=campusos_v2
JWT_SECRET=replace-with-at-least-32-random-characters
NODE_ENV=development
# For one TLS-terminating reverse proxy, e.g. Railway:
TRUST_PROXY=0
ADMIN_NAME=College Administrator
ADMIN_EMAIL=admin@example.invalid
# Set only when running npm run admin:create, then remove:
ADMIN_PASSWORD=
